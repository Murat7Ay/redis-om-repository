{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Crud": {
    "ConnectionString": "localhost:6379",
    "HistoryMaxLength": 100,
    "SoftDelete": true,
    "DefaultPageSize": 20,
    "MaxPageSize": 100,
    "RecreateStaleIndexes": true
  },
  "Auth": {
    "Issuer": "crudapp",
    "Audience": "crudapp",
    "TokenLifetimeMinutes": 60
  }
}
